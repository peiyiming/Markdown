<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/qp_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/qp_icon_button"
            android:contentDescription="返回"
            android:text="‹"
            android:textColor="@color/qp_text_primary"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_document_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/qp_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_save_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="已保存"
                android:textColor="@color/qp_text_tertiary"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_share"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="4dp"
            android:background="@drawable/qp_icon_button"
            android:contentDescription="分享到其他应用"
            android:text="分享"
            android:textAllCaps="false"
            android:textColor="@color/qp_text_primary"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/qp_mode_container"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="3dp">

            <Button
                android:id="@+id/btn_edit_mode"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:background="@drawable/qp_mode_button"
                android:contentDescription="编辑模式"
                android:text="编辑"
                android:textAllCaps="false"
                android:textColor="@color/qp_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_preview_mode"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:background="@drawable/qp_mode_button"
                android:contentDescription="手动预览模式"
                android:text="预览"
                android:textAllCaps="false"
                android:textColor="@color/qp_text_primary"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_live_mode"
                android:layout_width="46dp"
                android:layout_height="34dp"
                android:background="@drawable/qp_mode_button"
                android:contentDescription="实时双栏模式"
                android:text="实时"
                android:textAllCaps="false"
                android:textColor="@color/qp_text_primary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/qp_divider" />

    <LinearLayout
        android:id="@+id/editor_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="16dp">

        <EditText
            android:id="@+id/et_markdown_editor"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="sans"
            android:gravity="top|start"
            android:hint="从这里开始，记录你的想法…"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="8dp"
            android:textColor="@color/qp_text_primary"
            android:textColorHint="@color/qp_text_tertiary"
            android:textCursorDrawable="@null"
            android:textSize="17sp" />

        <View
            android:id="@+id/live_mode_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/qp_divider"
            android:visibility="gone" />

        <WebView
            android:id="@+id/web_markdown_preview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/qp_divider" />

    <HorizontalScrollView
        android:id="@+id/editor_toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/qp_surface"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">
            <Button android:id="@+id/btn_h1" android:layout_width="48dp" android:layout_height="40dp" android:background="@drawable/qp_tool_button" android:contentDescription="一级标题" android:text="H1" android:textAllCaps="false" android:textColor="@color/qp_text_primary" android:textStyle="bold" />
            <Button android:id="@+id/btn_bold" android:layout_width="48dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="粗体" android:text="B" android:textColor="@color/qp_text_primary" android:textStyle="bold" />
            <Button android:id="@+id/btn_italic" android:layout_width="48dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="斜体" android:text="I" android:textColor="@color/qp_text_primary" android:textStyle="italic" />
            <Button android:id="@+id/btn_quote" android:layout_width="52dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="引用" android:text="❝" android:textColor="@color/qp_text_primary" android:textSize="18sp" />
            <Button android:id="@+id/btn_unordered_list" android:layout_width="56dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="无序列表" android:text="• ≡" android:textAllCaps="false" android:textColor="@color/qp_text_primary" android:textSize="13sp" />
            <Button android:id="@+id/btn_ordered_list" android:layout_width="56dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="有序列表" android:text="1. ≡" android:textAllCaps="false" android:textColor="@color/qp_text_primary" android:textSize="12sp" />
            <Button android:id="@+id/btn_link" android:layout_width="52dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="插入链接" android:text="↗" android:textColor="@color/qp_text_primary" android:textSize="20sp" />
            <Button android:id="@+id/btn_image" android:layout_width="52dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="插入图片" android:text="▧" android:textColor="@color/qp_text_primary" android:textSize="20sp" />
            <Button android:id="@+id/btn_code" android:layout_width="56dp" android:layout_height="40dp" android:layout_marginLeft="6dp" android:background="@drawable/qp_tool_button" android:contentDescription="行内代码" android:text="&lt;/&gt;" android:textAllCaps="false" android:textColor="@color/qp_text_primary" android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
